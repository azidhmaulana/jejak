HOST=127.0.0.1
PORT=4174
JEJAK_API_URL=http://127.0.0.1:4174
JEJAK_DATA_DIR=.runtime
# Backend only: never prefix database credentials with VITE_.
DATABASE_URL=postgresql://jejak:REPLACE_WITH_SECRET@127.0.0.1:55432/jejak
JEJAK_TEST_DATABASE_URL=postgresql://jejak_test:REPLACE_WITH_TEST_SECRET@127.0.0.1:55432/jejak_test
JEJAK_DB_POOL_MAX=10
# Local Docker only. Production remote databases should use verify-full.
JEJAK_DB_SSL=disable
# JEJAK_DB_CA_FILE=/run/secrets/postgres-ca.pem
# JEJAK_DB_SCHEMA=public
# Separate migration owner credential; never needed by the running production app.
# JEJAK_MIGRATION_DATABASE_URL=postgresql://jejak_migrator:SECRET@postgres/jejak
# Keep the original map default, or select osm / satellite / carto-dark.
VITE_MAP_PROVIDER=esri-dark
# Optional offline package directory; existing BMS datasets can be copied here.
# MAP_DATA_DIR=.runtime/offline-maps
# MAP_ASSET_DIR=services/offline-maps/assets

# Server-only Redis for earthquake cache; use a private authenticated URL in production.
JEJAK_REDIS_URL=redis://127.0.0.1:56379
