{
  "name": "jejak",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs --production",
    "preview": "npm run start",
    "test": "node --test test/*.test.mjs",
    "test:offline": "npm test --workspace services/offline-maps",
    "test:browser": "playwright test",
    "format": "prettier --write src server scripts test vite.config.ts playwright.config.ts",
    "format:check": "prettier --check src server scripts test vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "express": "^5.1.0",
    "hls.js": "^1.7.4",
    "lucide-react": "^0.312.0",
    "maplibre-gl": "^6.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "terra-draw": "1.24.2",
    "terra-draw-maplibre-gl-adapter": "1.3.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitejs/plugin-react": "^4.2.1",
    "esbuild": "^0.25.0",
    "postcss": "^8.4.33",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.3.3",
    "vite": "^6.4.4"
  },
  "overrides": {
    "source-map-js": "1.2.2",
    "postcss-selector-parser": "7.1.6"
  },
  "workspaces": [
    "services/offline-maps"
  ],
  "engines": {
    "node": ">=24.0.0"
  }
}
